generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  name       String
  sortOrder  Int      @default(0) @map("sort_order")

  services   Service[]

  @@map("categories")
}

model Service {
  id         Int      @id @default(autoincrement())
  sortOrder  Int      @default(0) @map("sort_order")
  slug       String   @unique
  name       String
  price      String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  categoryId Int      @map("category_id")
  
  category   Category @relation(fields: [categoryId], references: [id])

  @@map("services")
}

model Review {
  id         Int      @id @default(autoincrement())
  imagePath  String?  @map("image_path")
  date       DateTime
  stars      Int
  author     String
  text       String
  sortOrder  Int      @default(0) @map("sort_order")

  @@map("reviews")
}

model Staff {
  id         Int      @id @default(autoincrement())
  name       String
  role       String
  photoPath  String   @map("photo_path")
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")

  @@map("staff")
}

model Portfolio {
  id         Int      @id @default(autoincrement())
  section    Section
  imagePath  String   @map("image_path")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("portfolio")
}

model Offer {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  description1 String?  @map("description_1")
  description2 String?  @map("description_2")
  
  offerItems   OfferItem[]

  @@map("offers")
}

model OfferItem {
  id         Int      @id @default(autoincrement())
  offerId    Int      @map("offer_id")
  title      String
  value      String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  sortOrder  Int      @default(0) @map("sort_order")
  
  offer      Offer    @relation(fields: [offerId], references: [id])

  @@map("offer_items")
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String?
  imagePath   String?  @map("image_path")
  isActive    Boolean  @default(true) @map("is_active")

  @@map("posts")
}

model ShopCategory {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")

  shopItems  ShopItem[]

  @@map("shop_categories")
}

model ShopItem {
  id                  Int      @id @default(autoincrement())
  name                String
  slug                String   @unique
  description         String?
  price               Float
  imagePath           String?  @map("image_path")
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  additionalImagePaths String[] @map("additional_image_paths")
  shopCategoryId      Int      @map("shop_category_id")
  
  shopCategory        ShopCategory @relation(fields: [shopCategoryId], references: [id])
  cartItems           CartItem[]

  @@map("shop_items")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  role        UserRole @default(REGULAR)
  displayName String   @map("display_name")
  isVerified  Boolean  @default(false) @map("is_verified")
  picture     String?
  phoneNumber String?  @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  method      AuthMethod
  
  cartItems   CartItem[]
  accounts    Account[]

  @@map("users")
}

model Account {
  id           String   @id @default(uuid())
  provider     String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  refreshToken String?  @map("refresh_token")
  accessToken  String?  @map("access_token")
  expiresAt    Int?     @map("expires_at")
  userId       String?  @map("user_id")
  
  User         User?    @relation(fields: [userId], references: [id])

  @@map("accounts")
}

model Token {
  id       String    @id @default(uuid())
  email String
  token    String @unique
  type     EnumToken
  expiresIn DateTime @map("expires_in")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("tokens")
}

model CartItem {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  sessionId   String?  @map("session_id")
  shopItemId  Int      @map("shop_item_id")
  variantId   Int?     @map("variant_id")
  quantity    Int      @default(1)
  
  shopItem    ShopItem @relation(fields: [shopItemId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@unique([userId, shopItemId, variantId])
  @@unique([sessionId, shopItemId, variantId])
  @@index([userId])
  @@index([sessionId])
  @@map("cart_items")
}

enum Section {
  NAILS
  BROWS
  LASHES
}

enum UserRole {
  REGULAR
  ADMIN
}

enum AuthMethod {
  CREDENTIALS
  GOOGLE
  YANDEX
}

enum EnumToken {
  VERIFICATION 
  PASSWORD_RESET
}